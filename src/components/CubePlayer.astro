---
interface Props {
  alg: string;
  setup?: string;
  puzzle?: string;
  size?: number;
}

const { alg, setup, puzzle = '3x3x3', size = 320 } = Astro.props;

// Prepend x2 so the yellow face ends up on U (matches speedcubing OLL/PLL view).
// Net effect of (x2 . setup . alg) is just x2 since alg = inverse(setup),
// so the cube finishes "solved with yellow on top".
const setupWithOrientation = setup ? `x2 ${setup}` : 'x2';
---

<twisty-player
  puzzle={puzzle}
  alg={alg}
  experimental-setup-alg={setupWithOrientation}
  background="none"
  control-panel="bottom-row"
  style={`width: ${size}px; height: ${size}px;`}
></twisty-player>
